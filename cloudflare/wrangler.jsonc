// Local runtime only. Terraform owns production resources and deployments.
{
  "name": "nematode-buddies-local",
  "main": "worker.mjs",
  "vars": { "RELEASE_TOKEN": "local-release-test" },
  "compatibility_date": "2025-09-01",
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }] },
  "migrations": [{ "tag": "live-v1", "new_sqlite_classes": ["LiveHub"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "nematode-local", "database_id": "00000000-0000-0000-0000-000000000001" }]
}
